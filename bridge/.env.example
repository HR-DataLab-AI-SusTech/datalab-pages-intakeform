# Schema only — no real values. Real values live in the deploy host's env.sops (see
# infrastructure/deployments/) or, for local dev, a git-ignored .env you create yourself.
# Never commit real values to this file or anywhere outside a secrets store.

# Postgres connection string for the `intake` database.
# Get it from: central-database's pg-oltp cluster — create the database first with
#   ./add-app-db.sh --cluster oltp intake
# on aisustechdb (see the central-database runbook), then build the URL from the app
# credentials that script prints.
INTAKE_DATABASE_URL=postgres://user:password@host:5432/intake

# The shared passphrase POST /submit and the submit_intake MCP tool require via
# X-Intake-Passphrase / the `passphrase` arg. Human-chosen, shared out of band with whoever
# is allowed to finalize an intake (it is the entire gate on this public endpoint — the form
# itself has no NetBird/mesh protection).
INTAKE_SUBMIT_PASSPHRASE=change-me

# Fine-grained GitHub PAT scoped ONLY to HR-DataLab-AI-SusTech/compass, with `contents:write`
# and `pull_requests:write` and nothing else. Minted by a human in GitHub's fine-grained PAT
# UI — never generated or requested by the bridge itself. When unset, a successful /submit
# still marks the intake row 'submitted' in Postgres; it just does not open the Compass PR
# (logged, not fatal).
COMPASS_GITHUB_TOKEN=

# Port the bridge's HTTP server listens on inside the container.
BRIDGE_PORT=3458

# ── Browser access ────────────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the REST routes from a browser. This is a real
# gate, not a formality: the form runs on a DIFFERENT origin from this bridge, so without a
# matching entry here the browser blocks every submission at the preflight and the server log
# stays empty. Never set this to `*` — that would let any page on the internet submit intakes.
# Default (used when unset) is the published GitHub Pages origin, so local dev is the case that
# needs to override it, e.g. INTAKE_ALLOWED_ORIGINS=http://127.0.0.1:8080
INTAKE_ALLOWED_ORIGINS=https://hr-datalab-ai-sustech.github.io

# Where to fetch the schema the PUBLISHED form is actually rendering. The bridge prefers this over
# its own bind-mounted copy, because Pages deploys from `main` while this container is pinned to an
# immutable sha — so the mounted file can be an older set of questions, and the chat agent would
# silently ask a different form than the web page shows. Falls back to the mount if the fetch
# fails, so a GitHub outage degrades to "possibly stale questions" rather than a broken tool.
FORM_CONFIG_URL=https://hr-datalab-ai-sustech.github.io/datalab-pages-intakeform/config/formConfig.json

# Path to the fallback copy inside the container (bind-mounted by docker-compose.yml). Only read
# when FORM_CONFIG_URL cannot be fetched.
FORM_CONFIG_PATH=/app/formConfig.json
